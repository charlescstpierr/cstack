{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/hooks/mode.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT}}/hooks/mode.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
